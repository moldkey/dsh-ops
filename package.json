{
  "name": "@liangjiehappy/dsh-ops",
  "version": "0.5.16",
  "description": "AI 宝塔 + AI 建站运维：一句话建站（nginx+证书自动配置）、站点体检（SEO/GEO/安全/真实流量）、部署前影响分析、出问题一键回滚；另含数据库备份与远程部署。含 BAOVOO 托管发布（ops_publish_hosted）。",
  "description_en": "AI control panel and site operations for DSH: one-sentence site creation (nginx + certificate), health checks (SEO/GEO/security/traffic), pre-deploy impact analysis, one-click rollback, database backup, migration checks and BAOVOO hosting publish.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dshio",
    "ops",
    "devops",
    "site-monitoring",
    "deployment",
    "seo",
    "geo",
    "snapshot",
    "rollback",
    "traffic",
    "logs",
    "diagnostics",
    "dshio-standard",
    "deepseekbase",
    "baovoo",
    "control-panel",
    "site-builder",
    "ai-baota"
  ],
  "license": "MIT",
  "homepage": "https://deepseekbase.com/work/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moldkey/dsh-ops.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dshio": {
    "standard": [
      "DSHIO/T 10",
      "DSHIO/T 21",
      "DSHIO/T 32"
    ],
    "registry": "https://deepseekbase.com/zh/plugins/",
    "bundles": "https://deepseekbase.com/bundles/"
  },
  "author": {
    "name": "deepseekbase"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  }
}
